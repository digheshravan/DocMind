# DocMind Environment Variables
# Copy this file to .env and fill in your values

# Required: Groq API key
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Database URL (default: SQLite for local dev)
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/docmind
DATABASE_URL=sqlite:///./docmind.db

# ChromaDB persistent storage path
CHROMA_PATH=./chroma_db
